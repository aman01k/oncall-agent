# Copy to .env and fill in. Never commit .env.

# Any OpenAI-compatible endpoint. Examples:
#   Groq:   https://api.groq.com/openai/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Read the current model IDs from the provider's model list before setting this.
LLM_MODEL=
LLM_TEMPERATURE=0.2

# Agent limits
AGENT_MAX_STEPS=10
AGENT_MAX_TOOL_OUTPUT_CHARS=4000

# Ports (avoid 5000 and 7000, used by macOS AirPlay)
SERVICE_PORT=8001
DASHBOARD_PORT=8501
